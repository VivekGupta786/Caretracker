# CareTrack environment variables
#
# This UI-only demo build does NOT require any environment variables and does NOT
# read this file. All data is stored in the browser via localStorage.
#
# The variables below are placeholders for a future production build that connects
# to Supabase. Do NOT commit real values. Add real values to a local .env file that
# is git-ignored.

# Public Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=your-project-url.supabase.co

# Public anon key (safe to expose in the browser; restricted by RLS)
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Service-role key is NEVER exposed in frontend code. It belongs only in a secure
# server/edge function environment. Do not prefix it with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=keep-this-server-side-only
